{
  "manifest_version": 3,
  "name": "Linux Command Explainer (AI)",
  "version": "2.0",
  "description": "Select any Linux command, and get a live, plain-English AI explanation.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Explain a Linux command", "default_popup": "popup.html" },
  "options_page": "options.html",
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Explain the selected Linux command"
    }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["commands.js", "content.js"] }
  ]
}
